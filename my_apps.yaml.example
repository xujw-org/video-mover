# Video Mover 配置模板
# ---------------------------------------------------------------------------
# 使用方法：复制为 my_apps.yaml 后填入你自己的值。
#   cp my_apps.yaml.example my_apps.yaml
# my_apps.yaml 不进仓库（见 .gitignore）；本模板只含占位符，不含任何真实
# cookie / 代理密码 / token，请勿把填好真实密钥的文件公开分享。
# ---------------------------------------------------------------------------

# Video Mover 主程序配置（main.py 读取）
# 优先级：环境变量 VIDEO_MOVER_* > 本文件 > 内置默认值（缺失时打警告，不直接崩）。
# 视频源支持多个博主：sources 列表里的每一项都会按顺序抓取，一个失败不中断其余源。
# 旧版单个 source 写法仍可用（此时环境变量 VIDEO_MOVER_SOURCE_* 仍可覆盖）；
# 一旦写了 sources，环境变量里的 SOURCE_* 不再生效，以列表为准。
video_mover:
  sources:
    - platform: douyin        # 视频源平台：douyin | tiktok；其它平台需显式写 f2_command
      account: "@example"     # 改成博主账号，例如 "@dance2026"
      url: "https://www.douyin.com/@example"  # 与 account 对应，改成博主主页地址
      # f2_command 不写时按平台推导（douyin -> ["f2", "dy"]，tiktok -> ["f2", "tk"]）
      # download_dir 不写时默认为 Download/<platform>/post/<account>，
      # 若 f2 实际写到别处请显式写，例如 download_dir: "Download/douyin/post/dance2026"
    - platform: douyin
      account: "@example2"
      url: "https://www.douyin.com/@example2"
  upload:
    douyin_account: "default"  # 抖音上传用的账号名；cookie 在 Upload/cookies/douyin_<账号名>.json
    # 上传 cookie 两种来源（推荐第一种，不用扫码、不用弹浏览器）：
    #   1) 由上面的 douyin.cookie 直接转换（creator.douyin.com 与 www 共用
    #      .douyin.com 作用域）：python Upload/export_cookie.py
    #   2) 传统方式：python Upload/cli_main.py douyin <账号名> login（随后扫码）
    headless: true   # 上传时无窗口跑（不会在桌面弹 Chrome）；调试界面时改 false
    dry_run: false   # true = 只把表单填到“发布”按钮前，不真正发布（也不删文件）
  paths:
    dedup_dir: "Dedup"
    upload_dir: "Upload"
    flush_script: "flush_device_id.py"
    dedup_script: "Dedup/dedup.py"
    # 上传脚本按顺序执行：默认只传抖音；想同时传视频号再加一行 "Upload/vx_upload.py"
    upload_scripts: ["Upload/douyin_upload.py"]
  schedule:
    interval_minutes: 300   # 调度间隔（分钟），必须是 1-1440 的整数，超出范围会报错
    timezone: "Asia/Singapore"  # 必须是合法的 IANA 时区名，例如 Asia/Shanghai
  runtime:
    max_workers: null       # null = CPU 核心数；也可填正整数
    config_file: "my_apps.yaml"  # 传给 f2 命令的 -c 参数，相对仓库根目录

# ---------------------------------------------------------------------------
# 以下为 f2（下载器）的平台配置，字段结构与原仓库保持一致。
# cookie / proxies 请填你自己的真实值；留空表示不使用。
# ---------------------------------------------------------------------------
douyin:
  headers:
    User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML,
      like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0
    Referer: https://www.douyin.com/
  cookie: "YOUR_DOYIN_COOKIE_HERE"
  proxies:
    http://: ""
    https://: ""
  # 下面几项是 f2 的抓取参数。注意：抖音从 2026-11-14 起改走浏览器通道
  # （douyin_fetch.py），因为这版 f2 的请求会被抖音新的 Argus secsdk 签名
  # 风控全部 403；此时 folderize / mode / naming 不再生效（抓取器直接按
  # Download/<昵称>/<作品时间>/<id>.mp4 落盘），只有 cookie 仍然必需。
  # 保留它们是为了以后 f2 修好签名、或手动跑 f2 时不用再改配置。
  folderize: yes
  mode: post
  naming: '{create}'
  # interval: 2025-03-07 20-00-00|2025-03-07 21-00-00

# f2 tk -c my_apps.yaml -u https://www.tiktok.com/@example -i 2025-03-07 21-00-00|2025-03-07 22-00-00
tiktok:
  headers:
    User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML,
      like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0
    Referer: https://www.tiktok.com/
  cookie: "YOUR_TIKTOK_COOKIE_HERE"
  proxies:
    http://: "http://YOUR_PROXY_USER:YOUR_PROXY_PASSWORD@YOUR_PROXY_HOST:PORT"
    https://: "http://YOUR_PROXY_USER:YOUR_PROXY_PASSWORD@YOUR_PROXY_HOST:PORT"
  music: no
  cover: no
  desc: yes
  folderize: yes
  mode: post
  naming: '{create}'
  # interval: 2025-03-07 20-00-00|2025-03-07 21-00-00

weibo:
  headers:
    User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML,
      like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0
    Referer: https://www.weibo.com/
  cookie: "YOUR_WEIBO_COOKIE_HERE"
  proxies:
    http://: ""
    https://: ""

twitter:
  headers:
    User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML,
      like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0
    Referer: https://twitter.com/
  cookie: "YOUR_TWITTER_COOKIE_HERE"
  proxies:
    http://: ""
    https://: ""

bark:
  key: ""
token: "YOUR_F2_TOKEN_HERE"
