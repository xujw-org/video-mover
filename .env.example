# Video Mover 环境变量覆盖（优先级高于 my_apps.yaml）
# 使用方法：复制为 .env 后填写真实值；.env 已加入 .gitignore，切勿提交。
# main.py 内置了一个极简 .env 解析器，不需要额外安装 python-dotenv。
# 注意：f2 本身读取的是 my_apps.yaml 里的 cookie / 代理配置，那些密钥不要写进 .env，
# 请直接填到本机的 my_apps.yaml（该文件不进仓库）。

# 视频源
VIDEO_MOVER_SOURCE_PLATFORM=tiktok
VIDEO_MOVER_SOURCE_ACCOUNT=@example
VIDEO_MOVER_SOURCE_URL=https://www.tiktok.com/@example
# f2 子命令，空格分隔，例如：f2 tk
VIDEO_MOVER_F2_COMMAND=f2 tk

# 路径（相对仓库根目录，或绝对路径）
VIDEO_MOVER_DOWNLOAD_DIR=Download/tiktok/post/example
VIDEO_MOVER_DEDUP_DIR=Dedup
VIDEO_MOVER_UPLOAD_DIR=Upload
VIDEO_MOVER_FLUSH_SCRIPT=flush_device_id.py
VIDEO_MOVER_DEDUP_SCRIPT=Dedup/dedup.py
VIDEO_MOVER_UPLOAD_SCRIPT=Upload/vx_upload.py

# 调度（interval 必须是 1-1440 的整数；timezone 必须是合法的 IANA 时区名）
VIDEO_MOVER_INTERVAL_MINUTES=300
VIDEO_MOVER_TIMEZONE=Asia/Singapore

# 运行（留空 = CPU 核心数）
VIDEO_MOVER_MAX_WORKERS=

# 配置文件路径（相对仓库根目录）
VIDEO_MOVER_CONFIG_FILE=my_apps.yaml

# 阿里云百炼 API Key（视频 AI 分析用，在阿里云百炼控制台获取）
# 注意：不要把真实 Key 写进代码或提交到仓库。
DASHSCOPE_API_KEY=
